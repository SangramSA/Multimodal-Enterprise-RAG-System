# ============================================================================
# MULTIMODAL ENTERPRISE RAG SYSTEM - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED: OpenAI Configuration
# ----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-actual-api-key-here

# ----------------------------------------------------------------------------
# OPTIONAL: OpenAI Model Configuration
# ----------------------------------------------------------------------------
# Model for text generation and entity extraction
OPENAI_MODEL=gpt-4o

# Model for image processing (captioning and OCR)
OPENAI_VISION_MODEL=gpt-4o

# Embedding model for vector search
EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimension (must match the embedding model)
EMBEDDING_DIMENSION=1536

# ----------------------------------------------------------------------------
# OPTIONAL: Neo4j Configuration
# ----------------------------------------------------------------------------
# Neo4j connection URI (default matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7687

# Neo4j username (default matches docker-compose.yml)
NEO4J_USER=neo4j

# Neo4j password (default matches docker-compose.yml)
NEO4J_PASSWORD=password

# ----------------------------------------------------------------------------
# OPTIONAL: Qdrant Configuration
# ----------------------------------------------------------------------------
# Qdrant connection URL (default matches docker-compose.yml)
QDRANT_URL=http://localhost:6333

# Qdrant API key (leave empty for local development)
QDRANT_API_KEY=

# ----------------------------------------------------------------------------
# OPTIONAL: Application Configuration
# ----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum file size in MB for uploads
MAX_FILE_SIZE_MB=100

# ----------------------------------------------------------------------------
# OPTIONAL: Evaluation Configuration
# ----------------------------------------------------------------------------
# Evaluation mode: development, production
EVAL_MODE=development

# Path to evaluation results log file
EVAL_LOG_PATH=logs/eval_results.json

# Enable caching for DeepEval results (reduces API calls)
DEEPEVAL_CACHE_ENABLED=true

# ----------------------------------------------------------------------------
# OPTIONAL: Confident AI Configuration
# ----------------------------------------------------------------------------
# Confident AI API key for evaluation reporting
# Get your API key from: https://www.confident-ai.com/
CONFIDENT_API_KEY=your_confident_api_key_here

# Legacy support: Also accepts CONFIDENT_AI_API_KEY
# CONFIDENT_AI_API_KEY=your_confident_api_key_here

# Confident AI project name
CONFIDENT_AI_PROJECT=your_project_name

# Confident AI API base URL (usually don't need to change)
CONFIDENT_AI_BASE_URL=https://api.confident-ai.com

# Enable Confident AI integration
CONFIDENT_AI_ENABLED=false

# ----------------------------------------------------------------------------
# OPTIONAL: LangSmith Configuration (for observability)
# ----------------------------------------------------------------------------
# LangSmith API key for tracing and observability
# Get your API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Alternative: Can also use LANGCHAIN_API_KEY (same value)
# LANGCHAIN_API_KEY=your_langsmith_api_key_here

# LangSmith project name (defaults to "multimodal-rag")
LANGCHAIN_PROJECT=multimodal-rag

# ============================================================================
# NOTES:
# ============================================================================
# 1. Only OPENAI_API_KEY is required. All other variables have defaults.
# 2. For local development with Docker Compose, Neo4j and Qdrant defaults work.
# 3. LangSmith and Confident AI are optional but recommended for production.
# 4. Never commit your .env file to version control!
# ============================================================================
